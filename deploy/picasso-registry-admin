#!/usr/bin/env bash
# picasso-registry-admin — server-side admin wrapper for the Docker deployment.
#
# Collapses the verbose `docker run --rm -v … token … && docker kill -HUP …`
# incantations into short subcommands, run on the box (directly or over SSH).
# It is the command surface the laptop-side admin CLI/GUI (the [admin] extra)
# drives — keeping all Docker specifics server-side and off the network (no
# HTTP token surface; authority is shell/SSH access, per ADR 001).
#
# Installed into /usr/local/bin by deploy/install-docker.sh. Self-configuring:
# the image + host port are read from the running container; override via the
# PR_ADMIN_* env vars below if your names differ.
#
# Usage:
#   picasso-registry-admin status
#   picasso-registry-admin token list
#   picasso-registry-admin token add  --scope write --label <holder>
#   picasso-registry-admin token rotate --label <holder>
#   picasso-registry-admin token revoke --label <holder>
#   picasso-registry-admin logs [-n N] [-f]
#   picasso-registry-admin restart
#   picasso-registry-admin upgrade <image-ref>      # e.g. ghcr.io/.../picasso-registry:0.9.0
#
# Needs Docker access (run as root or a docker-group user; upgrade needs root).
set -euo pipefail

CONTAINER="${PR_ADMIN_CONTAINER:-picasso-registry}"
ETC_DIR="${PR_ADMIN_ETC_DIR:-/etc/picasso-registry}"
CONTAINER_ETC="/etc/picasso-registry"
ENV_FILE_IN="$CONTAINER_ETC/registry.env"
# Stable copy of install-docker.sh that `upgrade` re-runs (install-docker.sh
# drops itself here on every deploy, so this works in pull-only installs too).
INSTALLER="${PR_ADMIN_INSTALLER:-/opt/picasso-registry/deploy/install-docker.sh}"

die() { echo "picasso-registry-admin: $*" >&2; exit 1; }
need_docker() {
  command -v docker >/dev/null 2>&1 || die "docker not found on PATH"
}

container_running() {
  [ "$(docker inspect -f '{{.State.Running}}' "$CONTAINER" 2>/dev/null)" = "true" ]
}

# The image the running container uses — token ops run a throwaway container of
# the SAME image, so the token CLI version always matches the service.
detect_image() {
  local img
  img="$(docker inspect -f '{{.Config.Image}}' "$CONTAINER" 2>/dev/null || true)"
  [ -n "$img" ] || die "container '$CONTAINER' not found — is it deployed? (set PR_ADMIN_CONTAINER)"
  printf '%s' "$img"
}

# Host port mapped to the container's 8000 (for health checks).
detect_port() {
  docker port "$CONTAINER" 8000/tcp 2>/dev/null | head -1 | sed 's/.*://' || true
}

cmd_status() {
  echo "container: $CONTAINER"
  docker ps -a --filter "name=^/${CONTAINER}$" \
    --format 'state:     {{.State}}\nstatus:    {{.Status}}\nimage:     {{.Image}}\nports:     {{.Ports}}' \
    || die "container '$CONTAINER' not found"
  local port; port="$(detect_port)"
  if [ -n "$port" ]; then
    if curl -fsS "http://127.0.0.1:${port}/health" >/dev/null 2>&1; then
      echo "health:    OK (http://127.0.0.1:${port}/health)"
    else
      echo "health:    NOT answering on port ${port}"
    fi
  fi
  # Report the image's self-stamped version (handy to confirm an upgrade).
  if container_running; then
    local ver
    ver="$(docker exec "$CONTAINER" python -c \
      'import picasso_registry as p; print(p.__version__)' 2>/dev/null || true)"
    [ -n "$ver" ] && echo "version:   $ver"
  fi
}

# Run the token CLI in a throwaway container of the running image, with the
# token dir mounted so the shared registry.env is read/written on the host.
token_run() {
  local image; image="$(detect_image)"
  docker run --rm -v "$ETC_DIR:$CONTAINER_ETC" "$image" \
    picasso-registry token "$@" --env-file "$ENV_FILE_IN"
}

# SIGHUP the running service so an add/rotate/revoke applies without downtime.
reload() {
  if container_running; then
    docker kill --signal=HUP "$CONTAINER" >/dev/null \
      && echo "reloaded: live token map (SIGHUP, no downtime)"
  else
    echo "note: container not running — tokens apply on next start" >&2
  fi
}

cmd_token() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    list)   token_run list "$@" ;;
    add)    token_run add "$@";    reload ;;
    rotate) token_run rotate "$@"; reload ;;
    revoke) token_run revoke "$@"; reload ;;
    ""|-h|--help)
      echo "usage: picasso-registry-admin token {list|add|rotate|revoke} [--scope read|write] [--label NAME]" ;;
    *) die "unknown token subcommand '$sub' (list|add|rotate|revoke)" ;;
  esac
}

cmd_logs() { docker logs "$@" "$CONTAINER"; }

cmd_restart() {
  docker restart "$CONTAINER" >/dev/null && echo "restarted: $CONTAINER"
}

cmd_upgrade() {
  local ref="${1:-}"
  [ -n "$ref" ] || die "usage: picasso-registry-admin upgrade <image-ref>  (e.g. ghcr.io/jungmannlab/picasso-registry:0.9.0)"
  [ -f "$INSTALLER" ] \
    || die "installer not found at $INSTALLER (set PR_ADMIN_INSTALLER)"
  [ "$(id -u)" -eq 0 ] || die "upgrade needs root — run via sudo"
  local port; port="$(detect_port)"
  echo "upgrading $CONTAINER -> $ref (port ${port:-8000}) via install-docker.sh"
  PULL_IMAGE="$ref" REGISTRY_PORT="${port:-8000}" bash "$INSTALLER"
}

usage() {
  sed -n '3,30p' "$0" | sed 's/^# \{0,1\}//'
}

main() {
  local cmd="${1:-}"; shift || true
  case "$cmd" in
    ""|-h|--help) usage; return 0 ;;
  esac
  need_docker   # every real command needs the docker CLI
  case "$cmd" in
    status)  cmd_status "$@" ;;
    token)   cmd_token "$@" ;;
    logs)    cmd_logs "$@" ;;
    restart) cmd_restart "$@" ;;
    upgrade) cmd_upgrade "$@" ;;
    *) die "unknown command '$cmd' (status|token|logs|restart|upgrade; -h for help)" ;;
  esac
}

main "$@"
